        <item name="android:windowBackground">@color/bk_background</item>
        <item name="android:statusBarColor">@color/bk_background</item>
        <item name="android:navigationBarColor">@color/bk_background</item>
        <item name="android:colorAccent">@color/bk_bamboo</item>
    </style>
</resources>
